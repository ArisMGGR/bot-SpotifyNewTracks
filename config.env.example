SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Optional, used only by: python -m spotify_tracker.login
# Must match a Redirect URI registered in your Spotify app; the login listens
# on 127.0.0.1 at this URI's port. Defaults to the value shown.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Filled in automatically by: python -m spotify_tracker.login
SPOTIFY_REFRESH_TOKEN=
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Optional: comma-separated artist names (or Spotify artist IDs) whose
# "Appears On" releases (features on other artists' records) are also checked.
# Costs extra API calls for each listed artist; see README.
# A name that contains a comma must be given by Spotify artist ID instead.
APPEARS_ON_ARTISTS=
